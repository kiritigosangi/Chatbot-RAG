# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# This example file is safe to commit — it holds no secrets.

# Mistral API key (PRD §8: LLM key in environment)
MISTRAL_API_KEY=

# Optional: pin the Mistral model to use for grounded generation
MISTRAL_MODEL=mistral-small-latest

# Storage backend: "neon" (PostgreSQL + pgvector) or "chroma" (local on-disk)
STORAGE=neon

# Neon PostgreSQL connection string
# postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=Neon Tech: postgresql://neondb_owner:npg_oxqhvnm02RMV@ep-autumn-rain-aysdgea9-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Embedding runtime: "fastembed" (ONNX, serverless) or "transformers" (torch, local)
EMBEDDING_BACKEND=fastembed
